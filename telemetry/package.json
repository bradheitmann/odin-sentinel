{
  "name": "odin-sentinel-telemetry-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Optional Cloudflare Worker that receives opt-in ODIN Sentinel session reports.",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:create": "wrangler d1 create odin-sentinel-telemetry",
    "db:migrate": "wrangler d1 execute odin-sentinel-telemetry --remote --file schema.sql",
    "db:migrate:local": "wrangler d1 execute odin-sentinel-telemetry --local --file schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240329.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.90.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
