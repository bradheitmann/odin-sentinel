{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "charter charter.toml",
  "description": "Version pin, project, owner, Slice Zero definition and the verification budget.",
  "type": "object",
  "required": ["charter_version", "project", "owner", "slice_zero", "verification_budget"],
  "additionalProperties": false,
  "properties": {
    "charter_version": { "const": "1" },
    "spec_version": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "slice_zero": {
      "type": "object",
      "required": ["description", "command", "proven_on"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "proven_on": { "type": "string" }
      }
    },
    "verification_budget": {
      "type": "object",
      "required": ["qa_attempts_per_slice", "repair_cycles_per_slice", "review_families_required"],
      "additionalProperties": false,
      "properties": {
        "qa_attempts_per_slice": { "type": "integer", "minimum": 1 },
        "repair_cycles_per_slice": { "type": "integer", "minimum": 1 },
        "review_families_required": { "type": "integer", "minimum": 1 },
        "seat_evidence": { "enum": ["required", "optional"], "description": "gaps-receipt-1: \"required\" refuses an accepted receipt unless every verifier carries a charter.seat-evidence/1 record (slices already accepted with their receipt are not re-judged). Set it only after every hook, CI job and seat runs a pin carrying this key: an older binary's check --strict refuses it as an unexpected field." }
      }
    },
    "land_check": {
      "type": "object",
      "description": "land-check-1: the pre-push landing gate. `enforce` (default false) makes the installed hook refuse any commit a push adds to `branch` that is neither an accepted slice merge nor a records-only commit.",
      "required": ["enforce", "branch"],
      "additionalProperties": false,
      "properties": {
        "enforce": { "type": "boolean" },
        "branch": { "type": "string", "minLength": 1 }
      }
    },
    "state": {
      "type": "object",
      "description": "state-lanes-1: the STATE rules. `max_commits_behind` (default 20) is the cadence limit; `branch` is the state branch (unset: main or master), where the cadence and 7-day rules bind without --landing; `park_allows` lists path prefixes a parked repository may still stage.",
      "additionalProperties": false,
      "properties": {
        "max_commits_behind": { "type": "integer", "minimum": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "park_allows": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pins": {
      "type": "object",
      "description": "DONE pin binding (fork-intake-2): the probe, its keys, the method label, the bind paths and the QA receipt template.",
      "required": ["probe", "keys", "method", "receipt"],
      "additionalProperties": false,
      "properties": {
        "probe": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "probe_candidates": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "method": { "type": "string", "minLength": 1 },
        "bind_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "receipt": { "type": "string", "minLength": 1 }
      }
    }
  }
}
