{
  "name": "@bradheitmann/odin-sentinel",
  "version": "0.4.8",
  "publishConfig": {
    "access": "public"
  },
  "description": "Portable MCP governance protocol for multi-agent terminal teams: 27 tools, 9 resources, readiness gates, ODIN watchers, receipts, delegation, and closeout over stdio.",
  "type": "module",
  "main": "./dist/src/protocol/index.js",
  "types": "./dist/src/protocol/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/protocol/index.d.ts",
      "import": "./dist/src/protocol/index.js"
    },
    "./mcp": {
      "types": "./dist/src/mcp/server.d.ts",
      "import": "./dist/src/mcp/server.js"
    },
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@11.0.3",
  "bin": {
    "odin-sentinel": "dist/src/bin/index.js",
    "odin-sentinel-mcp": "dist/src/bin/index.js"
  },
  "files": [
    "dist",
    "docs",
    "protocol",
    "templates",
    "scripts",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/bin/index.ts",
    "audit:public": "node scripts/audit/public-surface.mjs",
    "prepack": "pnpm run build",
    "test:package": "node scripts/audit/verify-pack.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "pnpm run audit:public && pnpm run typecheck && pnpm test && pnpm run build && pnpm run test:package"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-orchestration",
    "multi-agent",
    "sentinel"
  ],
  "author": "ODIN Sentinel contributors",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "yaml": "2.8.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "4.1.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bradheitmann/odin-sentinel.git"
  },
  "homepage": "https://github.com/bradheitmann/odin-sentinel#readme",
  "bugs": {
    "url": "https://github.com/bradheitmann/odin-sentinel/issues"
  },
  "odin": {
    "publicVersion": "0.4.8",
    "minimumCompatibleChildMcpVersion": "0.4.5"
  }
}
